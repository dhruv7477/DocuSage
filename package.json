{
  "name": "docusage-frontend",
  "version": "1.0.0",
  "description": "Frontend for DocuSage application",
  "type": "module",
  "main": "src/pages/App.tsx",
  "scripts": {
    "dev": "vite",
    "dev:api": "uvicorn src.main:app --host 127.0.0.1 --port 8010",
    "dev:api:reload": "uvicorn src.main:app --host 127.0.0.1 --port 8010 --reload",
    "dev:worker": "celery -A src.workers.celery_app worker --loglevel=info -Q ingestion,default,celery --pool=solo",
    "dev:full": "concurrently -n API,WORKER,WEB -c cyan,yellow,magenta --pad-prefix --restart-tries 2 --restart-after 3000 \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.99.2",
    "axios": "^1.15.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.73.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
