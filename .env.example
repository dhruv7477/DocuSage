# Local development settings. Copy to .env and it works as is with the services
# from docker/docker-compose.yml (Postgres, Redis, Qdrant, SeaweedFS, Ollama)
# and the app running on your machine. See README.md, "Local development".
#
# For the public demo stack, do not use this file: run scripts/demo-env.sh,
# which writes docker/.env for docker/docker-compose.demo.yml.
#
# Every setting has a default in src/configs/config.py. Commented lines show
# useful ones you may want to change.

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
# A JSON list. The Vite dev server runs on port 3000.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Security ─────────────────────────────────────────────────────
# At least 32 characters. For anything shared, generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=local-dev-only-secret-key-change-me-0123456789
# Google sign-in (optional). The same client ID goes to the frontend build.
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=

# ── Database (docker/docker-compose.yml defaults) ────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docusage
POSTGRES_USER=docusage_user
POSTGRES_PASSWORD=postgres

# ── Redis: token blacklist, Celery broker and results ────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vector store ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collections are named <prefix>_ws_<workspace id>. Data created before the
# rename to DocuSage used the prefix "privateai" (and bucket privateai-docs).
QDRANT_COLLECTION_PREFIX=docusage

# ── Object storage: any S3-compatible server (SeaweedFS in compose) ──
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docusage-docs
MINIO_SECURE=false
# Amazon S3 instead: STORAGE_BACKEND=s3 with AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_REGION and S3_BUCKET.

# ── LLM ──────────────────────────────────────────────────────────
# ollama (local, default) | openai (OpenAI or any OpenAI-compatible API such
# as Groq) | vllm (a self-hosted vLLM server).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Pull first: ollama pull qwen2.5:3b-instruct && ollama pull qwen2.5:1.5b-instruct
LLM_MODEL=qwen2.5:3b-instruct
ROUTER_MODEL=qwen2.5:1.5b-instruct
# SUMMARY_MODEL defaults to ROUTER_MODEL.
# The first answer loads the model into RAM, which can take minutes on CPU.
LLM_TIMEOUT_SECONDS=300

# Groq (or OpenAI) instead of Ollama:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
# ROUTER_MODEL=llama-3.1-8b-instant
# SUMMARY_MODEL=llama-3.1-8b-instant
# LLM_MAX_RETRIES=4

# ── Embeddings and reranking (run in-process on the CPU) ─────────
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# RERANKER=cross_encoder
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Abuse controls (off or generous for local use) ───────────────
# Quotas: 0 = unlimited.
# QUOTA_MAX_DOCUMENTS=0
# QUOTA_MAX_UPLOAD_MB=0
# QUOTA_QUESTIONS_PER_DAY=0
# RATE_LIMIT_ENABLED=true

# ── Logging and monitoring ───────────────────────────────────────
LOG_LEVEL=INFO
# SENTRY_DSN=
