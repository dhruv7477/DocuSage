# App
APP_NAME=
APP_ENV=
APP_DEBUG=
APP_HOST=
APP_PORT=
API_V1_PREFIX=
ALLOWED_ORIGINS=

# Security
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
ALGORITHM=

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Vector DB
VECTOR_STORE=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=

# Storage
STORAGE_BACKEND=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# LLM
# Default model is qwen2.5:7b-instruct (~4.7 GB, runs on CPU). Pull it with:
#   ollama pull qwen2.5:7b-instruct
# LLM_TIMEOUT_SECONDS defaults to 300 (5 min) — enough for Ollama to load a
# 7B model into RAM on first inference. Reduce if you're using a cloud API.
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=
OLLAMA_BASE_URL=
VLLM_BASE_URL=
VLLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Embeddings
# Default is BAAI/bge-small-en-v1.5 (384-dim, ~133 MB).
# If you switch EMBEDDING_MODEL after ingestion, also update
# EMBEDDING_DIMENSION and reindex via scripts/reindex_workspace.py.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=
EMBEDDING_DIMENSION=
OLLAMA_EMBED_MODEL=
OPENAI_EMBED_MODEL=

# RAG
RAG_TOP_K=
RAG_SCORE_THRESHOLD=
CHUNK_SIZE=
CHUNK_OVERLAP=

# Retrieval pipeline
REWRITER_STRATEGY=
ENABLE_HYDE=
RERANKER=
RERANKER_MODEL=
RETRIEVAL_CANDIDATE_K=
ABSTENTION_THRESHOLD=
ENABLE_HYBRID_SEARCH=

# Startup readiness — set STRICT_STARTUP=false only for tests / intentional
# degraded boots. STARTUP_PROBE_TIMEOUT_SECONDS=15 is a safe default; bump
# higher only if your network is consistently slow on cold first connections.
STRICT_STARTUP=
STARTUP_PROBE_TIMEOUT_SECONDS=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_CHAT_PER_MINUTE=

# Observability
SENTRY_DSN=
LOG_LEVEL=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=
