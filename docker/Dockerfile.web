# Frontend for the demo: the Vite build served by Caddy, which also
# terminates HTTPS and proxies /api to the API container.

# ── Build Stage ────────────────────────────────────────────────────
FROM node:22.23.3-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json tsconfig.node.json vite.config.ts tailwind.config.js postcss.config.js ./
COPY src ./src

# Optional: enables "Sign in with Google" when set at build time.
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

# ── Runtime Stage ──────────────────────────────────────────────────
FROM caddy:2.11.6-alpine

COPY docker/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
