# Serves the built frontend and proxies the API, behind automatic HTTPS.
# DEMO_DOMAIN is the site address. A public name gets a Let's Encrypt
# certificate (DNS must point here, ports 80 and 443 open). "localhost" gets
# a certificate from Caddy's own local CA.
#
# Access logs are off on purpose: the chat stream carries the question in the
# URL, and the demo does not keep visitors' questions.

{
	# "email <address>" when ACME_EMAIL is set in docker/.env, else empty:
	# the address Let's Encrypt (and the ZeroSSL fallback) can reach you at.
	{$ACME_EMAIL_OPTION}
	# Clients that send no server name (Java, and so ZAP, for "localhost")
	# still get this site's certificate.
	default_sni {$DEMO_DOMAIN:demo.example.com}
}

{$DEMO_DOMAIN:demo.example.com} {
	encode zstd gzip

	# Security headers on every response. The CSP allows only this site,
	# Google Fonts, and Google's sign-in script (loaded even when sign-in is
	# off). style-src needs 'unsafe-inline' for the inline style in
	# index.html and the toast library's injected styles; scripts stay
	# strict. blob: images are the cited page previews.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	# API, including the SSE chat stream. flush_interval -1 forwards each
	# event as soon as the app writes it. Uploads are capped just above the
	# app's own 50 MB limit, so the app still returns its JSON error.
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 51MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Liveness only, for an external uptime check. /health/deep is not proxied.
	handle /health {
		reverse_proxy api:8000
	}

	# Single-page app: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
