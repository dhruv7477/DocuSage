# Settings for docker/docker-compose.demo.yml.
#
# Do not copy this file by hand. Run scripts/demo-env.sh, which writes
# docker/.env from it and fills in random secrets. Docker Compose reads
# docker/.env automatically, because it sits next to the compose file.

# Public host name. Caddy requests a Let's Encrypt certificate for it, so DNS
# must point at this machine and ports 80 and 443 must be reachable.
# Use "localhost" to try the stack on your own machine (Caddy then issues a
# certificate from its own local CA, and your browser will warn once).
DEMO_DOMAIN=demo.example.com

# LLM: any OpenAI-compatible endpoint. The default is Groq. GROQ_API_KEY is
# sent as the bearer token to LLM_BASE_URL, so another provider's key works too.
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Model IDs: LLM_MODEL writes the answers, ROUTER_MODEL classifies each
# question, SUMMARY_MODEL summarises documents. Check
# https://console.groq.com/docs/models for current IDs and your limits.
LLM_MODEL=llama-3.3-70b-versatile
ROUTER_MODEL=llama-3.1-8b-instant
SUMMARY_MODEL=llama-3.1-8b-instant

# Demo limits (optional; these are the defaults). 0 means unlimited.
# QUOTA_MAX_DOCUMENTS=5
# QUOTA_MAX_UPLOAD_MB=25
# QUOTA_QUESTIONS_PER_DAY=30
# SUMMARY_MAX_TOTAL_CHUNKS=40
# Uploads are deleted every day at this hour (UTC). Samples stay.
# DEMO_WIPE_HOUR_UTC=3

# Secrets. scripts/demo-env.sh generates every empty value below.
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
